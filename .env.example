# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Google Sheets — pick ONE auth method:
#
# A) Service account (recommended for 24/7 bot — no token expiry):
#    Create service account in Google Cloud → download JSON →
#    Share spreadsheet with the service account email (Editor).
#    GOOGLE_SERVICE_ACCOUNT_PATH=C:\Users\zheng\.config\daisys-dough\service_account.json
#
# B) OAuth desktop (browser login; refresh token can expire if app is in Testing):
#    Default: %USERPROFILE%\.config\daisys-dough\oauth_client.json
#    Run setup-credentials.ps1 once. If invalid_grant: delete token.json, run verify.py
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_OAUTH_CLIENT_PATH=C:\Users\zheng\.config\daisys-dough\oauth_client.json
GOOGLE_TOKEN_PATH=C:\Users\zheng\.config\daisys-dough\token.json
# GOOGLE_SERVICE_ACCOUNT_PATH=C:\Users\zheng\.config\daisys-dough\service_account.json

# Behavior
TIMEZONE=America/Los_Angeles
REACT_ON_ERROR=true
FUZZY_MATCH_CUTOFF=0.75
